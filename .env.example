# ==============================================================================
# AUTOMOTIVE GARAGE POS & WORKSHOP MANAGEMENT (DUBAI, UAE)
# Vercel Deployment & Environment Configuration Template
# ==============================================================================

# 1. Database Configuration (Turso Cloud hosted libSQL database)
# Create your database in Turso: `turso db create garage-pos`
# Get URL: `turso db show garage-pos --url`
# Get Token: `turso db tokens create garage-pos`
TURSO_DATABASE_URL="libsql://your-garage-db.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# Local SQLite fallback for local offline testing (DO NOT USE ON VERCEL)
DATABASE_URL="file:./dev.db"

# 2. Authentication & Server-Side Security
# Generate via: `openssl rand -base64 32`
JWT_SECRET="replace_with_a_secure_random_32_byte_secret_key"
JWT_EXPIRES_IN="7d"
SESSION_SECRET="replace_with_session_signing_secret"

# 3. Permanent File Storage (Vercel Blob)
# Used for private receipts, invoice scans, and salary payment proofs
# Automatically provided by Vercel when adding Vercel Blob store, or add manually:
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_here"

# 4. Regional Workshop Settings (Dubai, UAE)
CURRENCY="AED"
TIMEZONE="Asia/Dubai"
DEFAULT_TAX_RATE="5.0"
PRIVATE_GARAGE_MODE="true"

# 5. Server Environment
NODE_ENV="production"
PORT=3000
