# ==============================================================================
# PRIVATE AUTOMOTIVE GARAGE POS — ENVIRONMENT CONFIGURATION
# Copy this file to .env before starting the application:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Application URL
APP_URL="http://localhost:3000"

# Local SQLite Database Path (Default: ./garage.db)
DATABASE_URL="file:./garage.db"

# Session & Token Secret (Set to any random secret in production)
SESSION_SECRET="garage_super_secret_master_key_2026_xyz"

# Workshop Mode: single private garage deployment
PRIVATE_GARAGE_MODE=true

# Optional AI Assistance (Gemini API for parts lookup / diagnosis)
GEMINI_API_KEY=""
