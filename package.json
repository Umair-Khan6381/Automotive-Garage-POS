{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "prisma generate --schema=Automotive-Garage-POS/backend/prisma/schema.prisma && vite build",
    "postinstall": "prisma generate --schema=Automotive-Garage-POS/backend/prisma/schema.prisma",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx Automotive-Garage-POS/backend/tests/run-tests.ts",
    "studio": "prisma studio --schema=Automotive-Garage-POS/backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=Automotive-Garage-POS/backend/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=Automotive-Garage-POS/backend/prisma/schema.prisma",
    "db:seed": "tsx Automotive-Garage-POS/backend/prisma/seed.ts",
    "db:backup": "tsx Automotive-Garage-POS/backend/database/backup-db.ts",
    "db:migrate:mongo": "tsx Automotive-Garage-POS/backend/database/migrate-to-mongodb.ts",
    "db:push": "prisma db push --schema=Automotive-Garage-POS/backend/prisma/schema.prisma"
  },
  "prisma": {
    "schema": "Automotive-Garage-POS/backend/prisma/schema.prisma"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@libsql/client": "0.8.0",
    "@prisma/adapter-libsql": "6.4.1",
    "@prisma/client": "6.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prisma": "6.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
